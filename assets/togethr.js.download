#${r}{
  --tg-po-accent:#6c3bf0;--tg-po-accent-dark:#4f20d3;--tg-po-ink:#151522;--tg-po-muted:#686878;
  --tg-po-surface:#fffdfa;--tg-po-success:#13b76a;--tg-po-night:#0b0c14;
  --tg-po-red:#ec565b;--tg-po-cyan:#31bec7;--tg-po-orange:#ff8b14;--tg-po-magenta:#c33aba;--tg-po-purple:#7251d6;
  position:fixed;z-index:2147483000;
  font:14px/1.3 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  color:var(--tg-po-ink);-webkit-font-smoothing:antialiased
}
#${r},#${r} *{box-sizing:border-box}
/* Expanded: full-viewport center + blur/dim on the root (must be on root to blur the page) */
#${r}:not(.tg-po-collapsed){
  inset:0;left:0;top:0;right:0;bottom:0;width:100%;max-width:none;
  display:flex;align-items:center;justify-content:center;pointer-events:none;
  background:rgba(11,12,20,.58);
  -webkit-backdrop-filter:blur(6px);
  backdrop-filter:blur(6px)
}
#${r} .tg-po-scrim{
  position:absolute;inset:0;z-index:0;pointer-events:auto;
  background:transparent
}
#${r}.tg-po-collapsed .tg-po-scrim{display:none}
#${r}:not(.tg-po-collapsed) .tg-po-shell{
  position:relative;z-index:1;pointer-events:auto;margin:max(16px,env(safe-area-inset-top,0px)) 16px
}
/* Collapsed: FAB only, default bottom-right (or custom left/top) */
#${r}.tg-po-collapsed{
  inset:auto;right:max(20px,env(safe-area-inset-right,0px));
  bottom:max(20px,env(safe-area-inset-bottom,0px));left:auto;top:auto;
  width:max-content;max-width:none;display:block;pointer-events:auto;
  background:transparent;
  -webkit-backdrop-filter:none;
  backdrop-filter:none
}
#${r}.tg-po-collapsed.tg-po-pos-custom{
  right:auto;bottom:auto
}
#${r}.tg-po-collapsed .tg-po-shell{display:none}
#${r}:not(.tg-po-collapsed) > .tg-po-fab-wrap{display:none}
#${r} .tg-po-fab-wrap{
  position:relative;display:grid;place-items:center;width:64px;height:64px;touch-action:none
}
#${r} .tg-po-halo,#${r} .tg-po-halo::after{
  position:absolute;inset:0;border-radius:50%;content:"";pointer-events:none;
  border:1px solid rgba(108,59,240,.24);background:rgba(108,59,240,.05);
  opacity:0;transform:scale(.9)
}
#${r} .tg-po-halo::after{inset:8px}
#${r}.tg-po-collapsed > .tg-po-fab-wrap > .tg-po-halo{
  animation:tg-po-halo-pulse 3.5s ease-out infinite
}
#${r} .tg-po-fab{
  position:relative;z-index:2;width:48px;height:48px;display:grid;place-items:center;
  border:0;border-radius:50%;color:#fff;cursor:pointer;padding:0;
  background:linear-gradient(145deg,#8050ff,var(--tg-po-accent-dark));
  box-shadow:0 12px 28px rgba(86,41,212,.34),inset 0 1px 0 rgba(255,255,255,.46);
  transition:transform 180ms ease,box-shadow 180ms ease;touch-action:none;user-select:none
}
#${r}.tg-po-dragging .tg-po-fab{cursor:grabbing;transform:scale(1.04)}
#${r} .tg-po-fab-motion{
  display:inline-grid;width:100%;height:100%;place-items:center;
  transform-origin:50% 58%;pointer-events:none
}
#${r} .tg-po-fab-icon{display:inline-grid;place-items:center;line-height:0}
#${r}.tg-po-collapsed > .tg-po-fab-wrap .tg-po-fab-motion{
  will-change:transform;
  animation:togethrPremiumBadgeNudge 3.5s cubic-bezier(.22,.8,.25,1) infinite
}
#${r}:not(.tg-po-collapsed) .tg-po-fab-motion,
#${r}:not(.tg-po-collapsed) .tg-po-halo{animation:none!important}
#${r}.tg-po-collapsed:focus-within > .tg-po-fab-wrap .tg-po-fab-motion,
#${r}.tg-po-nudge-paused > .tg-po-fab-wrap .tg-po-fab-motion,
#${r}.tg-po-collapsed > .tg-po-fab-wrap > .tg-po-fab:active .tg-po-fab-motion,
#${r}.tg-po-dragging > .tg-po-fab-wrap .tg-po-fab-motion,
#${r}.tg-po-collapsed:focus-within > .tg-po-fab-wrap > .tg-po-halo,
#${r}.tg-po-nudge-paused > .tg-po-fab-wrap > .tg-po-halo,
#${r}.tg-po-dragging > .tg-po-fab-wrap > .tg-po-halo{
  animation-play-state:paused
}
#${r}.tg-po-collapsed > .tg-po-fab-wrap > .tg-po-fab:hover,
#${r}.tg-po-collapsed:focus-within > .tg-po-fab-wrap > .tg-po-fab{
  transform:translateY(-2px) scale(1.025)
}
#${r} .tg-po-fab:active{transform:scale(.96)}
#${r} .tg-po-badge{
  position:absolute;z-index:3;top:1px;right:0;min-width:19px;height:19px;padding:0 5px;
  display:grid;place-items:center;border:2px solid #fff;border-radius:999px;color:#fff;
  background:#902cff;font-size:10px;font-weight:800;line-height:1;pointer-events:none
}
#${r} .tg-po-shell{
  position:relative;display:block;width:340px;max-width:calc(100vw - 40px);perspective:1200px;overflow:visible
}
/* With T&C: grow the flip card so terms live on the front face (always visible). */
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-card{
  height:auto;min-height:0
}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-face{
  height:auto;min-height:100%
}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-front{
  position:relative;inset:auto;height:auto;display:flex;flex-direction:column;
  padding:14px 16px 12px;border-radius:20px
}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-back{
  position:absolute;inset:0;height:auto;min-height:100%;border-radius:20px;
  display:flex;flex-direction:column;justify-content:center
}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-headline{margin:8px 0 4px;font-size:18px}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-support{margin:0 0 10px}
#${r} .tg-po-shell.tg-po-has-tnc .tg-po-hint{display:none}
#${r} .tg-po-tnc{
  margin:12px 0 0;padding:10px 12px;border-radius:12px;
  border:1px solid rgba(108,59,240,.14);
  background:linear-gradient(180deg,rgba(108,59,240,.06),rgba(108,59,240,.03));
  flex:0 0 auto
}
#${r}.tg-po-collapsed .tg-po-tnc{display:none}
#${r} .tg-po-tnc-title{
  margin:0 0 6px;color:var(--tg-po-accent-dark);
  font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;line-height:1.2
}
#${r} .tg-po-tnc-list{
  margin:0;padding:0;list-style:none;color:rgba(21,21,34,.78);
  font-size:11px;line-height:1.4;font-weight:550
}
#${r} .tg-po-tnc-list li{
  position:relative;margin:0;padding:3px 0 3px 14px
}
#${r} .tg-po-tnc-list li::before{
  content:"";position:absolute;left:0;top:.62em;width:5px;height:5px;border-radius:50%;
  background:var(--tg-po-accent);opacity:.72
}
#${r} .tg-po-tnc-list li + li{border-top:1px solid rgba(108,59,240,.08)}
#${r} .tg-po-attached-fab{
  position:absolute;z-index:8;top:-28px;right:-8px;transform:scale(.8);pointer-events:none
}
#${r} .tg-po-card{
  position:relative;width:100%;height:196px;min-height:0;transform-style:preserve-3d;
  transition:transform 700ms cubic-bezier(.2,.75,.18,1)
}
#${r}.tg-po-flipped .tg-po-card{transform:rotateY(180deg)}
#${r} .tg-po-face{
  position:absolute;inset:0;overflow:hidden;width:100%;height:100%;min-height:0;
  border-radius:20px;backface-visibility:hidden;-webkit-backface-visibility:hidden
}
#${r} .tg-po-front{
  padding:16px;border:1px solid rgba(26,22,53,.1);pointer-events:auto;
  background:radial-gradient(circle at 95% 95%,rgba(108,59,240,.1),transparent 28%),var(--tg-po-surface);
  box-shadow:0 20px 55px rgba(24,19,51,.16),0 3px 12px rgba(24,19,51,.07);
  transform:rotateY(0deg)
}
#${r}.tg-po-flipped .tg-po-front{pointer-events:none}
#${r} .tg-po-back{
  padding:14px 20px 12px;border:1px solid transparent;color:#fff;text-align:center;pointer-events:none;
  background:
    linear-gradient(var(--tg-po-night),var(--tg-po-night)) padding-box,
    linear-gradient(90deg,var(--tg-po-red),var(--tg-po-cyan),var(--tg-po-orange),var(--tg-po-magenta),var(--tg-po-purple)) border-box;
  box-shadow:0 24px 62px rgba(19,12,52,.32),0 0 25px rgba(108,59,240,.12);
  transform:rotateY(180deg)
}
#${r}.tg-po-flipped .tg-po-back{pointer-events:auto}
#${r} .tg-po-back::before{
  content:"";position:absolute;inset:-35% -25%;pointer-events:none;
  background:
    radial-gradient(circle at 22% 55%,rgba(49,190,199,.12),transparent 23%),
    radial-gradient(circle at 78% 48%,rgba(195,58,186,.13),transparent 24%);
  animation:tg-po-aurora 6s ease-in-out infinite alternate
}
#${r} .tg-po-spectrum{
  position:absolute;right:0;bottom:0;left:0;height:3px;pointer-events:none;
  background:linear-gradient(90deg,var(--tg-po-red),var(--tg-po-cyan),var(--tg-po-orange),var(--tg-po-magenta),var(--tg-po-purple),var(--tg-po-red));
  background-size:200% 100%;animation:tg-po-spectrum 4s linear infinite
}
#${r} .tg-po-copied{
  position:relative;display:flex;align-items:center;justify-content:center;gap:7px;
  margin:0 0 6px;color:var(--tg-po-success);font-size:11px;font-weight:650;letter-spacing:.04em
}
#${r} .tg-po-powered{
  position:relative;margin:0 0 4px;color:#b9bac8;font-size:9px;font-weight:700;letter-spacing:.22em
}
#${r} .tg-po-logo-stage{
  position:relative;display:grid;width:210px;height:72px;margin:0 auto 2px;place-items:center;overflow:hidden
}
#${r} .tg-po-logo-stage::before{
  content:"";position:absolute;inset:-18px -28px;border-radius:50%;
  background:conic-gradient(from 40deg,transparent,rgba(49,190,199,.18),transparent,rgba(195,58,186,.2),transparent,rgba(255,139,20,.17),transparent);
  filter:blur(15px);animation:tg-po-orbit 8s linear infinite
}
#${r} .tg-po-logo{
  position:relative;z-index:2;display:block;width:205px;height:72px;max-width:100%;
  object-fit:contain;object-position:center;filter:drop-shadow(0 4px 15px rgba(0,0,0,.35))
}
#${r} .tg-po-tagline{
  position:relative;margin:2px 0 4px;color:#f1f1f5;font-size:12px;line-height:1.25
}
#${r} .tg-po-topline{
  display:flex;align-items:center;min-height:24px;padding-right:8px;gap:8px;color:var(--tg-po-accent)
}
#${r} .tg-po-label{
  padding:4px 8px;border:1px solid rgba(108,59,240,.2);border-radius:999px;margin:0;
  color:var(--tg-po-accent-dark);background:rgba(108,59,240,.05);
  font-size:9px;font-weight:800;letter-spacing:.075em;white-space:nowrap
}
#${r} .tg-po-headline{
  display:flex;align-items:center;gap:7px;margin:11px 0 6px;
  font-size:20px;line-height:1.12;letter-spacing:-.025em;font-weight:700
}
#${r} .tg-po-check{
  flex:0 0 auto;width:18px;height:18px;display:inline-grid;place-items:center;
  border:1.5px solid var(--tg-po-success);border-radius:50%;
  color:var(--tg-po-success);font-size:11px;font-weight:700
}
#${r} .tg-po-support{
  margin:0 0 12px;color:var(--tg-po-muted);font-size:12px
}
#${r} .tg-po-actions{
  display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:stretch
}
#${r} .tg-po-code{
  min-width:0;min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:8px;
  padding:0 12px;margin:0;border:1.5px dashed rgba(108,59,240,.72);border-radius:10px;
  color:var(--tg-po-ink);background:rgba(255,255,255,.72);
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  font-size:13px;font-weight:800;letter-spacing:.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
#${r} .tg-po-code svg{flex:0 0 auto;color:var(--tg-po-accent)}
#${r} .tg-po-copy{
  appearance:none;min-height:44px;padding:0 17px;border:1px solid #11111d;border-radius:10px;
  background:#11111d;color:#fff;font:inherit;font-size:12px;font-weight:800;
  letter-spacing:.01em;white-space:nowrap;cursor:pointer
}
#${r} .tg-po-copy:hover{background:#28283a}
#${r} .tg-po-copy:disabled{opacity:.72;cursor:default}
#${r} .tg-po-hint{
  margin:8px 0 0;color:var(--tg-po-muted);font-size:10px;text-align:center;line-height:1.2
}
#${r} .tg-po-fab:focus-visible,
#${r} .tg-po-copy:focus-visible{
  outline:3px solid rgba(108,59,240,.38);outline-offset:3px
}
@keyframes togethrPremiumBadgeNudge{
  0%,78%,100%{transform:translate3d(0,0,0) rotate(0deg) scale(1)}
  81%{transform:translate3d(-1px,-1px,0) rotate(-3deg) scale(1.015)}
  84%{transform:translate3d(1px,0,0) rotate(4.5deg) scale(1.03)}
  87%{transform:translate3d(-1px,0,0) rotate(-2.5deg) scale(1.02)}
  90%{transform:translate3d(.5px,0,0) rotate(1.5deg) scale(1.01)}
  93%,96%{transform:translate3d(0,0,0) rotate(0deg) scale(1)}
}
@keyframes tg-po-halo-pulse{
  0%,78%,100%{opacity:0;transform:scale(.9)}
  81%{opacity:.3;transform:scale(.94)}
  90%{opacity:0;transform:scale(1.22)}
}
@keyframes tg-po-spectrum{to{background-position:-200% 0}}
@keyframes tg-po-aurora{to{transform:translate3d(4%,-2%,0) rotate(4deg)}}
@keyframes tg-po-orbit{to{transform:rotate(360deg)}}
@media (max-width:480px){
  #${r}{--tg-po-mobile-card-h:158px}
  #${r}:not(.tg-po-collapsed) .tg-po-shell{
    width:min(340px,calc(100vw - 24px));max-width:calc(100vw - 24px)
  }
  #${r}.tg-po-collapsed{
    right:max(12px,env(safe-area-inset-right,0px));
    bottom:max(14px,env(safe-area-inset-bottom,0px));
    width:max-content;max-width:none
  }
  #${r} > .tg-po-fab-wrap{width:46px;height:46px}
  #${r} > .tg-po-fab-wrap .tg-po-fab{width:44px;height:44px}
