  #${r} .tg-po-code-text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #${r} .tg-po-code svg{width:15px;height:15px;flex:0 0 auto}
  #${r} .tg-po-copy{
